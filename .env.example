# Required: OpenAI-compatible endpoint used by the Agens simulation judges.
export AGENS_SIM_JUDGE_BASE_URL="https://judge.example.com/v1"

# Optional for endpoints that do not require authentication.
export AGENS_SIM_JUDGE_API_KEY="replace-me"

# Judge defaults used by run.sh; override them for your endpoint.
export AGENS_SIM_JUDGE_MODEL="gpt-5.6-terra"
export AGENS_SIM_EXTRA_GLOBAL_JUDGE_MODEL="gpt-5.6-terra"

# Optional model/download and experiment tracking credentials.
# export HF_TOKEN="replace-me"
# export WANDB_API_KEY="replace-me"

# Optional training overrides.
# export MODEL_PATH="Qwen/Qwen3.6-35B-A3B"
# export TRAINER_LOGGER='["console","wandb"]'
# export MOUNT_ROOT="/workspace/webcatalyst/run_artifacts"
